        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="H2 - POST apertura de sesion" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
