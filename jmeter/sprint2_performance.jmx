        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="H4 - GET /sales y capturar IDs de Gin y Tonica" enabled="true">
          <stringProp name="HTTPSampler.path">/sales</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
